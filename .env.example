# ============================================
# Depo Stock — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el archivo .env al repositorio.

PORT=4000

# Secreto para firmar tokens JWT (mínimo 64 caracteres aleatorios)
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES

# PostgreSQL (Conexión individual)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=depo_stock
DB_USER=postgres
DB_PASSWORD=

# Alternativa: URL de conexión completa (Requerido para Supabase, Render, Vercel)
# Ej: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# CORS — Orígenes permitidos separados por coma (solo necesario en producción)
# CORS_ORIGINS=https://midominio.gob.ar,https://www.midominio.gob.ar
