{
  "name": "depo-stock",
  "version": "0.1.0",
  "description": "Sistema base de control de stock para depósito",
  "main": "backend/src/server.js",
  "scripts": {
    "build": "node --check backend/src/server.js && npm run build --prefix frontend && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'dist', {recursive:true});\"",
    "start": "node backend/src/server.js",
    "dev": "node backend/src/server.js",
    "test": "playwright test --project=api-smoke",
    "setup": "node backend/scripts/setup-database.js",
    "db:create": "node backend/scripts/create-database.js",
    "db:import": "node backend/scripts/import-data.js",
    "db:dump": "node backend/scripts/dump-database.js",
    "db:restore": "node backend/scripts/restore-database.js",
    "db:fingerprint": "node backend/scripts/db-fingerprint.js",
    "reset-admin": "node backend/scripts/reset-admin.js",
    "create-operador": "node backend/scripts/create-operador.js",
    "seed:test-schools": "node backend/scripts/seed-test-schools.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "supertest": "^7.2.2",
    "vercel": "^53.3.2"
  }
}
